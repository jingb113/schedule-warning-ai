# ============================================
# 工期预警管控系统 - 环境变量模板
# 复制为 .env（或直接设置系统环境变量）后按需填写
# 仓库内不含任何真实密钥；.env 已被 .gitignore 忽略
# ============================================

# ---------- 基础路径（可选，留空则用脚本所在目录） ----------
# 脚本/项目根目录；留空=脚本所在目录
BASE_DIR=
# 总进度计划 xlsx 的完整路径；留空=BASE_DIR/master_plan/总进度计划.xlsx
PLAN_FILE=
# 关键节点汇总 xlsx 的完整路径（可选）；留空=BASE_DIR/key_nodes/关键节点汇总.xlsx
KEYNODE_FILE=

# ---------- 项目名称（用于邮件标题，建议填写） ----------
PROJECT_NAME=示例项目

# ---------- 日报/计划表结构适配（可选，一般用默认值） ----------
# 日报工作表名
DAILY_SHEET_NAME=进行台账
# 日报文件名需包含的关键词，逗号分隔（任一命中即可）
DAILY_FILE_KEYWORDS=工程日报
# 总进度计划工作表名候选，逗号分隔；命中第一个即用，都不命中取第一个工作表
PLAN_SHEET_NAMES=

# ---------- 邮件配置（发邮件必填；留空则只生成报表不发邮件） ----------
# SMTP 服务器与端口（163=smtp.163.com:465，QQ=smtp.qq.com:465）
SMTP_SERVER=smtp.163.com
SMTP_PORT=465
# 发件邮箱
SMTP_USER=
# 邮箱「授权码」，非登录密码（在邮箱设置中单独申请）
SMTP_PASS=
# 收件人，多个用英文逗号分隔
EMAIL_RECIPIENTS=
# 设为 0 可临时禁用发邮件（只生成报表）
SEND_EMAIL=1

# ---------- 大模型 AI 分析（可选；留空 LLM_API_KEY 则关闭，回退规则分析） ----------
# OpenAI 兼容接口地址（DeepSeek / 通义千问 / 智谱 / Kimi / 内部网关均可）
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
# API 密钥（建议用非推理模型，推理模型思考 token 不可控易导致正文为空）
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---------- 调试开关（可选） ----------
# 设 1 导出邮件 HTML 预览到输出目录
DUMP_HTML=0
# 设 1 导出喂给大模型的上下文文本
DUMP_CTX=0

# ---------- Web 版监听地址（可选，仅 web/app.py 使用） ----------
# 默认仅监听本机；如需局域网访问改 0.0.0.0（注意安全风险）
WEB_HOST=127.0.0.1
WEB_PORT=8080
